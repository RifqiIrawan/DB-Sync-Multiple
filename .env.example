# Salin menjadi .env (JANGAN commit). Nilai di bawah hanya contoh.
DBSYNC_PG_PASSWORD=ganti_password_kuat
DBSYNC_MASTER_KEY=            # base64 32 byte -> infrastructure/scripts/generate-secrets.ps1
DBSYNC_JWT_KEY=               # >= 32 karakter
DBSYNC_ADMIN_PASSWORD=        # password admin awal (ganti setelah login pertama)
DBSYNC_PUBLIC_URL=https://dbsync.example.local:18443
DBSYNC_CDC_ENABLED=false